{
  "name": "@izumisy/react-preview",
  "version": "1.0.0",
  "description": "Vite plugin for rendering React component previews in isolated iframes",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "type-check": "tsc --incremental",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsdown": "^0.21.3",
    "typescript": "~5.9.3",
    "vitest": "^4.1.2"
  }
}
