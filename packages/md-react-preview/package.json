{
  "name": "@izumisy/md-react-preview",
  "version": "1.0.0",
  "description": "md-react-preview — component previewer powered by MDX",
  "bin": {
    "mrp": "./dist/cli.mjs"
  },
  "files": [
    "dist/**",
    "app/**"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "prepublishOnly": "tsdown",
    "type-check": "tsc --incremental",
    "lint": "oxlint",
    "fmt": "oxfmt --write src app/src",
    "fmt:check": "oxfmt --check src app/src",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@izumisy/vite-plugin-react-preview": "workspace:*",
    "@mdx-js/react": "^3.1.0",
    "@mdx-js/rollup": "^3.1.0",
    "@shikijs/langs": "^4.0.2",
    "@shikijs/themes": "^4.0.2",
    "@vitejs/plugin-react": "^4.5.2",
    "c12": "^3.3.3",
    "citty": "^0.2.1",
    "fast-glob": "^3.3.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "shiki": "^4.0.2",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
